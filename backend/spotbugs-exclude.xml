<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Ignore internal representation exposure for dependency injection -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.manga.library.service.ProviderConfigCache$ProviderData"/>
        <Or>
            <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
            <Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/>
        </Or>
    </Match>
</FindBugsFilter>
