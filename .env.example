# ==============================================================================
# Database Configuration
# ==============================================================================
POSTGRES_DB=manga_library
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ==============================================================================
# MinIO Configuration
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
# Point these at an external MinIO/S3. Two names, deliberately (AUDIT-D4): the backend's Java SDK
# treats a bare host as HTTPS so it needs the scheme, while the worker's Python SDK rejects a URL
# and takes TLS from its own flag. One shared variable could only ever suit one of them.
# MINIO_ENDPOINT_URL=http://minio:9000
# MINIO_ENDPOINT_HOST=minio:9000

# ==============================================================================
# Security & JWT Tokens
# ==============================================================================
# Required. The backend refuses to start if either is unset, shorter than the minimum, or one of
# the known-public development values (AUDIT-S1/S2). Under docker compose these are supplied as
# Docker secrets instead — secrets/jwt_secret.txt and secrets/internal_api_token.txt — and the
# variables below are only used when running the backend outside compose.
#   JWT_SECRET          at least 32 characters:  openssl rand -hex 32
#   INTERNAL_API_TOKEN  at least 16 characters:  openssl rand -hex 32
# For local development without secrets, run with SPRING_PROFILES_ACTIVE=local instead.
JWT_SECRET=
INTERNAL_API_TOKEN=

# ==============================================================================
# Traefik & Routing Configuration
# ==============================================================================
HOSTNAME=
CONTEXT_PATH=/tlhub
LOG_LEVEL=INFO
LOG_LEVEL_WORKER=DEBUG

# ==============================================================================
# Cloud AI Provider Keys
# Note: Keys can be supplied via .env or secrets/api_keys.json.
# If a key exists in secrets/api_keys.json, it takes precedence and overrides .env.
# If omitted or empty in secrets/api_keys.json, the .env value is preserved and used.
# ==============================================================================
# Fallback/Default Key (used if a provider-specific key is missing)
API_KEY=

# Provider-Specific Keys
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NEUROMETRIC_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ==============================================================================
# Model Configuration (Unified worker singleton settings)
# ==============================================================================

# 1. OCR Model Configuration (To use cloud OCR set DISABLE_LOCAL_OCR to true)
OCR_MODEL_PROVIDER=openrouter
OCR_VLM_MODEL=qwen/qwen3-vl-32b-instruct
# Fallback list for OCR (Active model at index 0, followed by fallback models)
OCR_VLM_MODEL_LIST=qwen/qwen3-vl-32b-instruct,google/gemini-3.5-flash,google/gemini-3.1-flash-lite,@cf/meta/llama-3.2-11b-vision-instruct

# 2. Translation (TL) Model Configuration
TL_MODEL_PROVIDER=openrouter
TL_LLM_MODEL=deepseek/deepseek-v4-pro
# Fallback list for Translation (Active model at index 0, followed by fallback models)
TL_LLM_MODEL_LIST=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,google/gemini-3.5-flash,@cf/meta/llama-3.3-70b-instruct-fp8-fast

# 3. Quality Assurance (QA) Model Configuration
QA_MODEL_PROVIDER=openrouter
QA_LLM_MODEL=deepseek/deepseek-v4-flash
# Fallback list for QA LLM
QA_LLM_MODEL_LIST=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro,google/gemini-3.5-flash,@cf/openai/gpt-oss-20b
QA_VLM_MODEL=google/gemini-3.1-flash-lite
# Fallback list for QA VLM
QA_VLM_MODEL_LIST=google/gemini-3.1-flash-lite,google/gemini-3.5-flash,@cf/meta/llama-3.2-11b-vision-instruct

# ==============================================================================
# Local AI Model Configuration (Step 2 Fallback)
# ==============================================================================
# Supported local providers: lmstudio, ollama
# Endpoint for local model (leave blank to auto-detect based on provider):
#   - ollama   -> http://ollama:11434/v1/chat/completions
#   - lmstudio -> http://host.docker.internal:1234/v1/chat/completions
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_ENDPOINT=http://ollama:11434/v1/chat/completions
LOCAL_LLM_MODEL=gemma4:e4b
LOCAL_VLM_MODEL=qwen2.5-vl-3b-instruct
DISABLE_LOCAL_LLM=true

# ==============================================================================
# Local & Cloud OCR Configurations
# ==============================================================================
# Set this to false to use local PP-models
DISABLE_LOCAL_OCR=false
PADDLEOCR_DET_MODEL=PP-OCRv6_medium_det
PADDLEOCR_REC_MODEL=PP-OCRv6_medium_rec
PADDLEOCR_DEVICE=cpu

# ==============================================================================
# Fallback Engines (DeepL & Google Translate)
# ==============================================================================
DISABLE_DEEPL_TRANSLATE=true
DEEPL_API_KEY=
DISABLE_GOOGLE_TRANSLATE=true

# ==============================================================================
# Performance & Service Configurations
# ==============================================================================
# Rate limit for translation requests. E.g. "60" (60 RPM) or "10" (10 RPM)
RATE_LIMIT=10
REGISTRY_OWNER=sagnikdas53
USE_REMOTE_ML=false
REMOTE_ML_URL=http://worker:8000
QA_MODE=auto

# Concurrency
# Global cap on jobs the worker runs at once, then the per-tier reservations within it.
#
# Raised from 2/1/1 on 2026-08-02 (AUDIT-W10). The first fully-drained run measured 90.8% of total
# job lifetime as queue wait, almost all of it in the light tier: qa (53.8s p50), translation
# (30.5s), render (1.0s) and layout (0.2s) shared one slot, so a layout job waited a 591s median
# to do 0.2s of work. Light was 94.7 s/page against heavy's 23.4 s/page while the heavy slot idled
# 95.9% of the time. Four light slots levels the two tiers; the work is network-bound LLM calls,
# so it costs little CPU (worker averaged 22.5%).
#
# Leave the two MAX_ values blank to derive light = CONCURRENT_JOBS - heavy. The worker clamps any
# combination that would compute to zero or negative slots and logs what it changed (AUDIT-W6).
CONCURRENT_JOBS=5
MAX_HEAVY_SLOTS=1
MAX_LIGHT_SLOTS=4

# Backend dispatcher poll interval in ms. Lower = jobs start sooner.
# Default was 30000 (30s) which caused ~2-3 min per page; 2000 restores fast handoff.
WORKER_POLL_MS=2000

# When true (default), light jobs can use idle heavy slots for extra throughput.
REUSE_IDLE_SLOTS=true
