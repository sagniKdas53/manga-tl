# Fresh setup: python3 scripts/dev_setup.py init
# Secrets live in secrets/api_keys.json and individual secret files, never in Git.
# Catalog defaults are generated into secrets/runtime/models.env by init.
# Use docker-compose.dev.yml for the isolated dev box; see docs/dev-box-setup.md.

# Existing production Compose routing (unused by the isolated dev stack).
HOSTNAME=localhost
CONTEXT_PATH=/tlhub
POSTGRES_DB=manga_library
# database/init.sql assigns objects to this role.
POSTGRES_USER=tladmin
MINIO_ROOT_USER=minioadmin

# Runtime policy and hardware. Raise threads and CPU quota together.
LOG_LEVEL=INFO
LOG_LEVEL_WORKER=INFO
LOG_PAYLOAD_MAX_CHARS=2000
PADDLEOCR_DEVICE=cpu
DISABLE_LOCAL_OCR=false
DISABLE_LOCAL_LLM=true
DISABLE_DEEPL_TRANSLATE=true
DISABLE_GOOGLE_TRANSLATE=true
CONCURRENT_JOBS=5
MAX_HEAVY_SLOTS=1
MAX_LIGHT_SLOTS=4
WORKER_POLL_MS=2000
WORKER_CPUS=2.0
WORKER_THREADS=2
WORKER_MEMORY=4g

# Optional dev box ports/project name (defaults shown).
# DEV_PROJECT_NAME=manga-quality-dev
# DEV_HTTP_PORT=18080
# DEV_MINIO_PORT=19000
# DEV_MINIO_CONSOLE_PORT=19001

# Optional explicit overrides; these are still active in the current application.
# Normally edit config/providers.json, rerun init, and recreate the dev services.
# OCR_MODEL_PROVIDER=
# OCR_VLM_MODEL=
# TL_MODEL_PROVIDER=
# TL_LLM_MODEL=
# QA_MODEL_PROVIDER=
# QA_LLM_MODEL=
# QA_VLM_MODEL=
# QA_MODE=auto
# *_MODEL_LIST overrides remain supported; see docs/environment-and-bootstrap.md.
# PADDLEOCR_LOCAL_MODEL=PP-OCRv6
# Leave PADDLEOCR_DET_MODEL / PADDLEOCR_REC_MODEL unset for language-aware routing.
# Local LLM servers are opt-in and provisioned separately:
# LOCAL_LLM_PROVIDER=ollama
# LOCAL_LLM_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
# LOCAL_LLM_MODEL=
# LOCAL_VLM_MODEL=
# External storage uses MINIO_ENDPOINT_URL (backend URL) and MINIO_ENDPOINT_HOST
# (worker host:port) with the production Compose file, not the isolated dev stack.
