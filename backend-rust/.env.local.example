# Local development environment for the Rust backend.
#
# Copy this file to .env.local (it is gitignored) and `cargo run` will pick it up.
#   cp .env.local.example .env.local
#
# Every value here is a DEVELOPMENT placeholder — production reads real values from
# Docker secrets and docker-compose.yml environment blocks instead.

APP_PROFILE=local
CONTEXT_PATH=/tlhub
PORT=8080

# Postgres. The stack's db publishes 127.0.0.1:5432 (see docker-compose.yml).
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/manga_library
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Known-insecure placeholders; tolerated ONLY because APP_PROFILE=local.
JWT_SECRET=dev-only-insecure-jwt-secret-do-not-use-in-production-0000000000
INTERNAL_API_TOKEN=dev-only-insecure-internal-token-do-not-use-in-production

# RUST_LOG takes precedence if set (e.g. RUST_LOG=debug,tower_http=info).
LOG_LEVEL=debug
