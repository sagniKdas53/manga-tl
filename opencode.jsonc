{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "orchestrator",
    "attachment": {
        "image": {
            "auto_resize": true
        }
    },
    "provider": {
        "openrouter": {
            "models": {
                "stealth/ox-alpha": {},
                "dots-studio/dots-3-note-preview:free": {}
            }
        }
    },
    "plugin": [
        "opencode-helicone-session",
        "opencode-wakatime"
    ],
    "mcp": {
        "mui-mcp": {
            "type": "local",
            "enabled": true,
            "command": [
                "npx",
                "-y",
                "@mui/mcp@latest"
            ]
        }
    },
    "lsp": true,
    "formatter": true,
    "autoupdate": true,
    "experimental": {
        "batch_tool": true
    }
}