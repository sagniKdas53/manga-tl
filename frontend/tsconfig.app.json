{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    // `vitest/globals` because vite.config.ts sets `test.globals: true`, so the suites call
    // describe/it/expect/beforeEach without importing them. Without this the typechecker sees
    // every one of them as an undefined name.
    "types": ["vite/client", "vitest/globals"],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
