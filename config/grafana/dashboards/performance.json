{
  "uid": "manga-performance",
  "title": "Stack Performance",
  "tags": [
    "manga-library"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "manga-library-prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{name!=\"\"}, name)",
          "refId": "A"
        },
        "regex": "",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "manga-worker",
            "manga-backend",
            "manga-db",
            "manga-valkey",
            "manga-minio"
          ],
          "value": [
            "manga-worker",
            "manga-backend",
            "manga-db",
            "manga-valkey",
            "manga-minio"
          ]
        },
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "stage",
        "label": "Stage",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "manga-library-postgres"
        },
        "query": "SELECT DISTINCT type FROM jobs ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Machine CPU",
      "description": "Every cgroup on the box, not just this stack — the root cgroup includes the browser, the editor and anything else running. That is the number the worker's 2.0-CPU cap was set against: the cap exists so this can stay under 100% while a job runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "manga-library-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "rate(container_cpu_usage_seconds_total{id=\"/\"}[$__rate_interval]) / scalar(machine_cpu_cores) * 100",
          "legendFormat": "machine",
          "range": true,
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Worker CPU vs cap",
      "description": "The worker's own usage as a percentage of the 2.0 CPUs it is allowed, read live from the cgroup rather than hardcoded — change WORKER_CPUS and this follows. 100% here means it is using its whole allowance, which is the point at which the cap starts costing throughput. The ignoring(cpu) is load-bearing: cAdvisor puts a cpu=\"total\" label on the usage counter and none on the quota, so a plain division matches no series and the panel reads No data.",
      "datasource": {
        "type": "prometheus",
        "uid": "manga-library-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "rate(container_cpu_usage_seconds_total{name=\"manga-worker\"}[$__rate_interval]) / ignoring(cpu) (container_spec_cpu_quota{name=\"manga-worker\"} / container_spec_cpu_period{name=\"manga-worker\"}) * 100",
          "legendFormat": "worker",
          "range": true,
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Worker memory",
      "description": "Working set against the 4g limit. Working set, not usage: it excludes reclaimable page cache, so it is the figure that actually decides whether the container gets OOM-killed. The measured peak when that limit was chosen was 2.1 GiB, i.e. about 53% here.",
      "datasource": {
        "type": "prometheus",
        "uid": "manga-library-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "container_memory_working_set_bytes{name=\"manga-worker\"} / container_spec_memory_limit_bytes{name=\"manga-worker\"} * 100",
          "legendFormat": "worker",
          "range": true,
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Worker throttled",
      "description": "Share of CPU scheduling periods in which the kernel stopped the worker because it had already spent its 2.0-CPU quota. Zero means the cap is not costing anything. Anything sustained above a few percent means jobs are running slower than the hardware could, and raising WORKER_CPUS would buy throughput — at the desktop's expense.",
      "datasource": {
        "type": "prometheus",
        "uid": "manga-library-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "rate(container_cpu_cfs_throttled_periods_total{name=\"manga-worker\"}[$__rate_interval]) / rate(container_cpu_cfs_periods_total{name=\"manga-worker\"}[$__rate_interval]) * 100",
          "legendFormat": "throttled",
          "range": true,
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 5
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Jobs in flight",
      "description": "Jobs that have started and not yet finished, right now. This is the load the pipeline is putting on the machine; the four panels to the left are what the machine is doing about it.",
      "datasource": {
        "type": "postgres",
        "uid": "manga-library-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "manga-library-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"in flight\"\nFROM jobs\nWHERE started_at IS NOT NULL\n  AND status NOT IN ('COMPLETED', 'FAILED')",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Machine load",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU by container",
      "description": "Stacked, so the height of the stack is what this stack costs the machine. The dashed 'machine total' line sits above it — the gap between the two is everything that is not a container (browser, editor, desktop). A run that looks slow with a small gap is the pipeline's fault; a small stack under a full machine is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "manga-library-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"$container\"}[$__rate_interval])",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "rate(container_cpu_usage_seconds_total{id=\"/\"}[$__rate_interval])",
          "legendFormat": "machine total",
          "range": true,
          "refId": "B",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "machine total"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Worker: cap, usage, throttling",
      "description": "The cap question in one panel. 'used' against 'cap' shows headroom; 'throttled %' on the right axis shows whether the kernel is actually enforcing it. Throttling rising while used sits flat at the cap is the signature of a CPU-bound stage — OCR, typically.",
      "datasource": {
        "type": "prometheus",
        "uid": "manga-library-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "rate(container_cpu_usage_seconds_total{name=\"manga-worker\"}[$__rate_interval])",
          "legendFormat": "used (cores)",
          "range": true,
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "container_spec_cpu_quota{name=\"manga-worker\"} / container_spec_cpu_period{name=\"manga-worker\"}",
          "legendFormat": "cap (cores)",
          "range": true,
          "refId": "B",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "rate(container_cpu_cfs_throttled_periods_total{name=\"manga-worker\"}[$__rate_interval]) / rate(container_cpu_cfs_periods_total{name=\"manga-worker\"}[$__rate_interval]) * 100",
          "legendFormat": "throttled %",
          "range": true,
          "refId": "C",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cap (cores)"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "throttled %"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory working set",
      "description": "Reclaimable page cache excluded, so this is the number the OOM killer looks at. The worker's 4g limit is drawn as a dashed line; the others are uncapped and shown for context, because on a 19 GB box they compete with each other and with the desktop.",
      "datasource": {
        "type": "prometheus",
        "uid": "manga-library-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "container_memory_working_set_bytes{name=~\"$container\"}",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "container_spec_memory_limit_bytes{name=\"manga-worker\"}",
          "legendFormat": "worker limit",
          "range": true,
          "refId": "B",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
