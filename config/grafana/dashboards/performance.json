    {
      "type": "timeseries",
      "title": "Worker CPU vs stage work time",
      "description": "The correlation panel, and the only one drawing on both datasources at once: CPU cores from Prometheus on the left axis, p95 work time from Postgres on the right. Work time climbing while CPU is pinned means the machine is the limit. Work time climbing while CPU is idle means it is waiting on something else, which on this pipeline is almost always a model API.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "rate(container_cpu_usage_seconds_total{name=\"manga-worker\"}[$__rate_interval])",
          "legendFormat": "worker CPU (cores)",
          "range": true,
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "manga-library-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(started_at, $__interval),\n  percentile_cont(0.95) WITHIN GROUP (\n    ORDER BY extract(epoch FROM (updated_at - started_at))\n  ) AS \"work p95 (s)\"\nFROM jobs\nWHERE $__timeFilter(started_at)\n  AND started_at IS NOT NULL\n  AND type IN ($stage)\nGROUP BY 1\nORDER BY 1",
          "refId": "B",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
