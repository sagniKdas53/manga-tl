          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Disk and network",
      "description": "Summed across the selected containers rather than broken out per container, which keeps this to four readable lines instead of twenty: cAdvisor reports network per interface (eth0 and eth1 both exist here, for manga-net and revProxy-net) and disk per device, so the unaggregated form lists the same container several times under one name. Mostly this is how you tell a stage that is genuinely computing from one that is waiting on MinIO or on a model API — a CPU-flat, network-busy stretch is a provider call, not local work. Drop the sum() to break it out per container.",
      "datasource": {
        "type": "prometheus",
        "uid": "manga-library-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "sum(rate(container_fs_reads_bytes_total{name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "disk read",
          "range": true,
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "sum(rate(container_fs_writes_bytes_total{name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "disk write",
          "range": true,
          "refId": "B",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "sum(rate(container_network_receive_bytes_total{name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "net in",
          "range": true,
          "refId": "C",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "manga-library-prometheus"
          },
          "expr": "sum(rate(container_network_transmit_bytes_total{name=~\"$container\"}[$__rate_interval]))",
          "legendFormat": "net out",
          "range": true,
          "refId": "D",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Pipeline load",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Jobs in flight by stage",
      "description": "Line this up against 'CPU by container' above — this is the cause and that is the effect. Note that started_at is only populated from 2026-08-15 onward; before that the column is NULL and this panel is legitimately empty rather than reporting zero load.",
      "datasource": {
        "type": "postgres",
        "uid": "manga-library-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "manga-library-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- Concurrency, not throughput: one row per bucket per stage counting the jobs that were\n-- open across that instant. generate_series gives the buckets and the join is an interval\n-- overlap, which is why this is a count of in-flight work rather than of starts.\n-- $__interval is Grafana's own bucket width, so the row count is bounded by maxDataPoints\n-- no matter how wide the time range gets.\nSELECT\n  b.bucket AS time,\n  j.type   AS metric,\n  count(*) AS value\nFROM generate_series(\n       $__timeFrom()::timestamptz,\n       $__timeTo()::timestamptz,\n       '$__interval'::interval\n     ) AS b(bucket)\nJOIN jobs j\n  ON j.started_at <= b.bucket\n AND j.updated_at >  b.bucket\nWHERE j.started_at IS NOT NULL\n  AND j.type IN ($stage)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
