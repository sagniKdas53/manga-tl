    {
      "type": "timeseries",
      "title": "Queue wait p95",
      "description": "How long a job sat between being created and being picked up. This is the backpressure signal: wait climbing while the worker is at its CPU cap means the cap is the bottleneck, whereas wait climbing with CPU idle points at slot configuration (CONCURRENT_JOBS, MAX_HEAVY_SLOTS) rather than at the hardware.",
      "datasource": {
        "type": "postgres",
        "uid": "manga-library-postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "manga-library-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(created_at, $__interval),\n  type AS metric,\n  percentile_cont(0.95) WITHIN GROUP (\n    ORDER BY extract(epoch FROM (started_at - created_at))\n  ) AS \"wait\"\nFROM jobs\nWHERE $__timeFilter(created_at)\n  AND started_at IS NOT NULL\n  AND type IN ($stage)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1,
