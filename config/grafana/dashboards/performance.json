      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "manga-library-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  started_at AS \"started\",\n  type       AS \"stage\",\n  round(extract(epoch FROM (updated_at - started_at))::numeric, 1) AS \"work (s)\",\n  round(extract(epoch FROM (started_at - created_at))::numeric, 1) AS \"wait (s)\",\n  status,\n  left(trace_id, 8) AS trace\nFROM jobs\nWHERE $__timeFilter(started_at)\n  AND started_at IS NOT NULL\n  AND type IN ($stage)\nORDER BY (updated_at - started_at) DESC NULLS LAST\nLIMIT 50",
