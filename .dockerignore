# Allowlist-style: exclude everything, then re-include ONLY what
# backend-rust/Dockerfile actually COPYs.
# The build context is the repo root; without this, a single `cargo test`
# run in backend-rust/ drags its 38 GB target/ into every build.
*

# --- Frontend source (stage 1 of backend-rust/Dockerfile) ---
!frontend/
frontend/node_modules
frontend/dist

# --- Rust backend ---
!backend-rust/
backend-rust/target

# --- Shared runtime files referenced by compose/config ---
!config/
!database/
!scripts/diff_routes.py

# Never enter a build context, even via an allowed directory:
**/*.log
**/logs/
.env
**/.env.local
secrets/
