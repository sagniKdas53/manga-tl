diff --git a/frontend/src/utils/inpainting.ts b/frontend/src/utils/inpainting.ts
new file mode 100644
index 0000000..f63427c
--- /dev/null
+++ b/frontend/src/utils/inpainting.ts
@@ -0,0 +1,33 @@
+/**
+ * Metadata for an immutable cleanup patch attached to a normal editable layer element.
+ *
+ * Geometry and visibility deliberately stay on the element: changing text must never move a
+ * cleanup patch, while normal element edits remain enough to move, resize, hide, or delete it.
+ */
+export interface InpaintingAsset {
+  assetId: string;
+  sha256: string;
+  byteLength: number;
+  mimeType: string;
+  bounds: { x: number; y: number; width: number; height: number };
+  archivePath?: string;
+  url?: string;
+}
+
+export type InpaintingAssets = Record<string, InpaintingAsset>;
+
+export function inpaintingAssets(
+  metadata: Record<string, unknown> | null | undefined,
+): InpaintingAssets {
+  if (!metadata || metadata.kind !== "inpainting") return {};
+  const assets = metadata.assets;
+  if (!assets || typeof assets !== "object" || Array.isArray(assets)) return {};
+  return assets as InpaintingAssets;
+}
+
+export function inpaintingAssetForElement(
+  metadata: Record<string, unknown> | null | undefined,
+  elementId: string,
+): InpaintingAsset | undefined {
+  return inpaintingAssets(metadata)[elementId];
+}
