+/// Authenticated, page-scoped access to a patch owned by a materialized inpainting element.
+pub async fn get_inpainting_asset(
+    State(state): State<AppState>,
+    _user: AuthUser,
+    Path((page_id, element_id)): Path<(Uuid, Uuid)>,
+) -> Response {
+    let metadata: Option<serde_json::Value> = sqlx::query_scalar(
+        "SELECT l.metadata_json FROM layers l JOIN layer_elements e ON e.layer_id=l.id \
+         WHERE l.page_id=$1 AND e.id=$2 AND l.type='inpainting' AND l.metadata_json->>'kind'='inpainting'",
+    ).bind(page_id).bind(element_id).fetch_optional(&state.pool).await.unwrap_or(None);
+    let Some(metadata) = metadata else {
+        return StatusCode::NOT_FOUND.into_response();
+    };
+    let Some(sha) = metadata
+        .get("assets")
+        .and_then(|v| v.get(element_id.to_string()))
+        .and_then(|v| v.get("sha256"))
+        .and_then(|v| v.as_str())
+    else {
+        return StatusCode::NOT_FOUND.into_response();
+    };
+    if sha.len() != 64 || !sha.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    stream_cached_image(&state.storage, &scene_asset_path(page_id, sha), "cleanup").await
+}
