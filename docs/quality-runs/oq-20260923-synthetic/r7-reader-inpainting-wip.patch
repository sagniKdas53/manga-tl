+/// Materialize worker cleanup patches once as normal editable elements.  The marker is the
+/// inpainting layer itself: an intentionally emptied/hidden layer is still a completed choice,
+/// so a deleted patch is never resurrected by a later Reader refresh.
+pub async fn materialize_inpainting(
+    State(state): State<AppState>,
+    user: AuthUser,
+    Path(page_id): Path<Uuid>,
+) -> Response {
+    let instance = "/api/pages/{pageId}/inpainting";
+    if user.role.eq_ignore_ascii_case("viewer") {
+        return error::access_denied(instance);
+    }
+    let mut tx = match state.pool.begin().await {
+        Ok(tx) => tx,
+        Err(_) => return error::internal_error(instance),
+    };
+    let exists: bool = sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM pages WHERE id = $1 FOR UPDATE)")
+        .bind(page_id)
+        .fetch_one(&mut *tx)
+        .await
+        .unwrap_or(false);
+    if !exists {
+        return error::not_found(&format!("Page not found: {page_id}"), instance);
+    }
+    let existing: Option<Uuid> = sqlx::query_scalar(
+        "SELECT id FROM layers WHERE page_id = $1 AND type = 'inpainting' \
+         AND metadata_json->>'kind' = 'inpainting' LIMIT 1",
+    )
+    .bind(page_id)
+    .fetch_optional(&mut *tx)
+    .await
+    .unwrap_or(None);
+    if existing.is_some() {
+        let _ = tx.rollback().await;
+        return Json(json!({ "status": "already_materialized" })).into_response();
+    }
+
+    let regions: Vec<OcrRegion> = sqlx::query_as(
+        "SELECT * FROM ocr_regions WHERE page_id = $1 AND cleanup_patch_asset_id IS NOT NULL \
+         AND cleanup_patch_sha256 IS NOT NULL AND cleanup_bounds IS NOT NULL \
+         AND COALESCE(approved, TRUE) = TRUE AND COALESCE(LOWER(region_type), '') <> 'sfx'",
+    )
+    .bind(page_id)
+    .fetch_all(&mut *tx)
+    .await
+    .unwrap_or_default();
+    let mut candidates = Vec::new();
+    for region in regions {
+        let Some(bounds) = region.cleanup_bounds.as_ref() else { continue };
+        let (Some(x), Some(y), Some(width), Some(height)) = (
+            bounds.get("x").and_then(|v| v.as_i64()),
+            bounds.get("y").and_then(|v| v.as_i64()),
+            bounds.get("width").and_then(|v| v.as_i64()),
+            bounds.get("height").and_then(|v| v.as_i64()),
+        ) else { continue };
+        if width <= 0 || height <= 0 { continue; }
+        let sha = region.cleanup_patch_sha256.clone().unwrap();
+        if state.storage.exists(&scene_asset_path(page_id, &sha)).await {
+            candidates.push((region, x, y, width, height, sha));
+        }
+    }
+    if candidates.is_empty() {
+        let _ = tx.rollback().await;
+        return (StatusCode::CONFLICT, Json(json!({ "status": "cleanup_not_ready" }))).into_response();
+    }
+    let layer_id = Uuid::new_v4();
+    let text_floor: i32 = sqlx::query_scalar(
+        "SELECT COALESCE(MIN(z_order), 0) FROM layers WHERE page_id=$1 AND LOWER(type) IN ('translation','sfx')",
+    ).bind(page_id).fetch_one(&mut *tx).await.unwrap_or(0);
+    if sqlx::query(
+        "INSERT INTO layers (id, created_at, metadata_json, target_language, type, visible, z_order, page_id) \
+         VALUES ($1,now(),'{\"kind\":\"inpainting\",\"assets\":{}}'::jsonb,NULL,'inpainting',true,$2,$3)",
+    ).bind(layer_id).bind(text_floor.saturating_sub(1)).bind(page_id).execute(&mut *tx).await.is_err() {
+        return error::internal_error(instance);
+    }
+    let mut assets = serde_json::Map::new();
+    for (region, x, y, width, height, sha) in candidates {
+        let element_id = Uuid::new_v4();
+        sqlx::query(
+            "INSERT INTO layer_elements (id, auto_size, box_shape, font, font_style, font_weight, is_manually_edited, \
+             max_height, max_width, overflow, rotation, size, text, visible, word_wrap, x, y, layer_id, region_id) \
+             VALUES ($1,false,'rectangular','Comic Neue','normal','normal',false,$2,$3,false,0,16,'',true,false,$4,$5,$6,$7)",
+        )
+        .bind(element_id).bind(height as i32).bind(width as i32).bind(x as f64).bind(y as f64)
+        .bind(layer_id).bind(region.id).execute(&mut *tx).await.is_err() {
+            return error::internal_error(instance);
+        }
+        assets.insert(
+            element_id.to_string(),
+            json!({
+                "assetId": region.cleanup_patch_asset_id,
+                "sha256": sha,
+                "byteLength": region.cleanup_patch_byte_length.unwrap_or(0),
+                "mimeType": "image/png",
+                "bounds": { "x": x, "y": y, "width": width, "height": height },
+                "archivePath": format!("inpainting/{element_id}.png"),
+            }),
+        );
+    }
+    let metadata = json!({ "kind": "inpainting", "assets": assets });
+    if sqlx::query("UPDATE layers SET metadata_json=$2 WHERE id=$1")
+        .bind(layer_id)
+        .bind(metadata)
+        .execute(&mut *tx)
+        .await
+        .is_err()
+    {
+        return error::internal_error(instance);
+    }
+    if crate::page_freshness::advance_page_revision(&mut tx, page_id)
+        .await
+        .is_err()
+        || tx.commit().await.is_err()
+    {
+        return error::internal_error(instance);
+    }
+    Json(json!({ "status": "materialized", "layerId": layer_id })).into_response()
+}
